<?xml version="1.0"?>
<sdf version="1.8">
  <model name="erc_book">
    <link name="book_base_link">

      <inertial>
        <pose>-6.97503397632341E-18 0.025 0 0 0 0</pose>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000702500</ixx>
          <ixy>5.421010862E-21</ixy>
          <ixz>-6.5594231435E-20</ixz>
          <iyy>0.002202500</iyy>
          <iyz>0</iyz>
          <izz>0.001625000</izz>
        </inertia>
      </inertial>

      <visual name="base_link_book_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.06 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>BOOK_COLOUR_PLACEHOLDER</ambient>
          <diffuse>BOOK_COLOUR_PLACEHOLDER</diffuse>
        </material>
      </visual>

      <collision name="base_link_book_collision">
        <pose>0 0 0 0 0 0</pose>
        <max_contacts>4</max_contacts>

        <geometry>
          <box>
            <size>0.25 0.06 0.16</size>
          </box>
        </geometry>
        <!-- Explicit friction so books sit on the shelf without sliding and the
             gripper can hold them. Was previously inheriting the world default. -->
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Softer contact than a rigid default reduces solver stress and
                   jitter for many resting books; tune if grasps feel spongy. -->
              <kp>100000.0</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

    </link>
  </model>
</sdf>
