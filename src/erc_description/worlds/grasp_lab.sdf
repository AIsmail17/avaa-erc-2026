<?xml version="1.0" ?>
<!-- A bench for the grasp alone: the robot, one book, and nothing else.

     The arena world costs a thirteen minute run to reach a grasp, and eleven of those
     minutes exercise an approach that is already understood. This world has no shelf, no
     markers, no walls and one book instead of twenty, so it starts in seconds and the
     physics has almost nothing to solve.

     The world is called erc_world on purpose. Every tool in tools/ addresses
     /world/erc_world/..., and sim_grasp_fix defaults to it, so the whole existing
     toolbox works here unchanged.

     PHYSICS_ENGINE_PLACEHOLDER is filled in by grasp_lab.launch.py from ERC_PHYSICS.
     That is the point of the bench: the gripper's four-bar is built from mimic joints,
     and Gazebo only honours mimic constraints under bullet-featherstone. Under the
     default the constraints are silently dropped -- Physics.cc:1906 says so in the log
     on every launch -- which is why the fingers pass through each other. -->
<sdf version="1.8">
  <world name="erc_world">

    <physics name="default" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
PHYSICS_ENGINE_PLACEHOLDER
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- The Sensors system, purely so the bench can be WATCHED.

         It was left out when this world was written, because the bench has no cameras
         and rendering is most of what the arena spends its time on. But it is also what
         renders tools/spectator.py, and without it that camera spawns, reports
         "create said: data: true", and never produces a topic at all -- which looks
         exactly like a frozen view.

         ogre2 through EGL, headless, which is the path that has never failed here. The
         Gazebo GUI needs an OpenGL context through GLX and cannot get a working one in
         this container; the server rendering sensors offscreen is unaffected by that,
         and is how the robot is actually watched. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A post under the book, not a shelf. The book has to be lifted off something or
         a successful grasp cannot be told from a book that was never supported, but a
         narrow post keeps it clear of the fingers and costs almost no collision work.
         BOOK_STAND_* are filled in by the launch so the book height can be swept. -->
    <model name="book_stand">
      <static>true</static>
      <pose>BOOK_STAND_X BOOK_STAND_Y BOOK_STAND_HALF_Z 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 0.12 BOOK_STAND_Z</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 0.12 BOOK_STAND_Z</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.3 0.3 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light name="light_front" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>0.3 0.3 -1</direction>
    </light>
    <light name="light_back" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <direction>-0.3 -0.3 -1</direction>
    </light>

  </world>
</sdf>
