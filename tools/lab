#!/usr/bin/env bash
# The grasp bench: the robot, one book, and nothing else.
#
#     tools/lab up [dart|bullet] [moveit]
#                                    bring the bench up (default dart, no move_group)
#     tools/lab down                 stop it
#     tools/lab status               is it running, and how fast
#     tools/lab log [n]              tail the bench log
#     tools/lab run <script> [args]  run a tools/ script against the bench
#
# A full arena run costs thirteen minutes and spends eleven of them on an approach that
# is already understood. This brings up a world with no shelf, no markers, no walls, no
# bin, one book instead of twenty and no cameras, so the same grasp can be tried in
# under a minute -- and tried again immediately after an edit.
#
# The world is named erc_world, like the arena, so every script in tools/ addresses it
# unchanged.
set -u
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONTAINER=erc_sim
LOG=/tmp/lab.log

die() { echo "$*" >&2; exit 1; }

docker exec "$CONTAINER" true 2>/dev/null || die "the $CONTAINER container is not running"

launched() {
    docker exec "$CONTAINER" bash -c \
        'ps -eo args | grep -v grep | grep -q "[g]rasp_lab.launch.py"'
}

rtf() {
    docker exec "$CONTAINER" /entrypoint.sh bash -c \
        'timeout 12 gz topic -t /stats -e -n 1 2>/dev/null | grep real_time_factor' \
        2>/dev/null | head -1 | awk '{print $2}'
}

cmd="${1:-status}"
shift || true

teardown() {
    # Bracketed, so pkill does not match the shell that is running it.
    #
    # Without the bracket the first pattern killed this very bash -c -- its command line
    # contains every name in the loop -- so the rest of the list was never swept and the
    # "something is still running" warning below fired on leftovers this was supposed to
    # have removed.
    docker exec "$CONTAINER" bash -c '
        for p in "[g]rasp_lab.launch.py" "[s]imulation.launch.py" "[s]olution.launch.py" \
                 "[m]oveit.launch.py" "[s]im_grasp_fix" "[g]z sim" \
                 "[c]ontroller_manager" "[s]pawner"; do
            pkill -f "$p" 2>/dev/null
        done
        true' 2>/dev/null
    for i in $(seq 1 20); do
        left=$(docker exec "$CONTAINER" bash -c \
            'ps -eo args | grep -v grep | grep -c "gz sim"' 2>/dev/null || echo 0)
        [ "${left:-0}" = "0" ] && return 0
        [ "$i" = "10" ] && docker exec "$CONTAINER" bash -c 'pkill -9 -f "gz sim"' 2>/dev/null
        sleep 1
    done
    echo "warning: something is still running in the container" >&2
}

case "$cmd" in
up)
    engine="${1:-dart}"
    case "$engine" in
        dart|bullet|bullet-featherstone) ;;
        *) die "engine must be dart or bullet, not $engine" ;;
    esac
    # move_group is off by default: it costs a slow startup and the jaw tests do not
    # plan anything. tools/labgrasp.sh, which runs the real grasp controller, needs it.
    want_moveit=false
    [ "${2:-}" = "moveit" ] && want_moveit=true
    [ "${MOVEIT:-0}" = "1" ] && want_moveit=true

    # Anything already talking to a world will fight this one for the same topics, and
    # a HALF-dead one is worse than a live one. Bringing the bench up three seconds after
    # a pkill once produced this, which reads as a physics engine fault and is not:
    #
    #     [WARN]  Controller already loaded, skipping load_controller
    #     [ERROR] Could not configure controller with name 'arm_left_controller'
    #             because no controller with this name exists
    #
    # The spawners had found the OUTGOING controller_manager, loaded into it, and then
    # asked the incoming one to configure what it had never loaded. So: kill, then wait
    # until the processes are actually gone, rather than sleeping and hoping.
    teardown

    # What the window needs, when one is wanted.
    #
    # There is no /dev/dri in WSL, so Mesa has no hardware DRI screen and falls back to
    # software GLX -- the drisw path -- which moves pixels through MIT shared memory.
    # QT_X11_NO_MITSHM would take that away and the GUI would abort on a missing OpenGL
    # context; it is deliberately not set anywhere near this. See the long note in
    # tools/sim under the gui command for the measurement.
    gui_env=()
    if [ "${HEADLESS:-true}" != "true" ] && grep -qi microsoft /proc/version 2>/dev/null; then
        gui_env=(-e "DISPLAY=${DISPLAY:-:0}"
                 -e XDG_RUNTIME_DIR=/tmp/runtime-root
                 -e LD_LIBRARY_PATH=/usr/lib/wsl/lib)
        if [ "${GUI_SOFTWARE:-1}" = "1" ]; then
            gui_env+=(-e LIBGL_ALWAYS_SOFTWARE=1 -e GALLIUM_DRIVER=llvmpipe)
            echo "    window on the CPU (GUI_SOFTWARE=0 to try the GPU instead)"
        else
            gui_env+=(-e GALLIUM_DRIVER=d3d12 -e MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA)
            echo "    window on the GPU"
        fi
    fi

    echo "=== bringing the bench up on $engine physics"
    docker exec -d "${gui_env[@]+"${gui_env[@]}"}" \
        -e "ERC_PHYSICS=$engine" \
        -e "ERC_LAB_X=${ERC_LAB_X:-0.75}" \
        -e "ERC_LAB_Y=${ERC_LAB_Y:-0.0}" \
        -e "ERC_LAB_Z=${ERC_LAB_Z:-1.00}" \
        -e "ERC_LAB_COLOUR=${ERC_LAB_COLOUR:-yellow}" \
        -e "ERC_GRASP_FIX=${ERC_GRASP_FIX:-0}" \
        "$CONTAINER" /entrypoint.sh bash -c \
        "source /opt/erc_ws/install/setup.bash && \
         ros2 launch erc_bringup grasp_lab.launch.py headless:=${HEADLESS:-true} \
         moveit:=$want_moveit > $LOG 2>&1"

    # The controllers are spawned on an eight second timer and the slowest of them is
    # what decides when the bench is usable, so wait for the broadcaster rather than
    # guessing at a sleep.
    echo -n "waiting for the controllers"
    for i in $(seq 1 40); do
        if docker exec "$CONTAINER" bash -c \
            "grep -q 'Configured and activated' $LOG 2>/dev/null"; then
            echo " up after ${i}x3 s"
            break
        fi
        if docker exec "$CONTAINER" bash -c \
            "grep -qi 'Could not.*controller_manager\|Failed to load' $LOG 2>/dev/null"; then
            echo
            echo "!!! the controllers failed to come up. On bullet-featherstone this is"
            echo "!!! the known gz_ros2_control issue #440. Last lines:"
            docker exec "$CONTAINER" bash -c "tail -15 $LOG"
            exit 1
        fi
        echo -n "."
        sleep 3
    done

    echo "real-time factor $(rtf)"
    docker exec "$CONTAINER" bash -c "grep -c 'does not support .*mimic' $LOG 2>/dev/null" \
        | { read -r n; echo "mimic constraints refused by the physics engine: $n"; }
    ;;

down)
    teardown
    echo "bench down"
    ;;

status)
    if launched; then
        echo "bench running, real-time factor $(rtf)"
        docker exec "$CONTAINER" /entrypoint.sh bash -c \
            'source /opt/erc_ws/install/setup.bash && timeout 10 ros2 control list_controllers 2>/dev/null' \
            | sed 's/^/  /'
    else
        echo "bench not running"
    fi
    ;;

log)
    docker exec "$CONTAINER" bash -c "tail -${1:-40} $LOG"
    ;;

run)
    [ $# -ge 1 ] || die "usage: tools/lab run <script> [args]"
    exec "$REPO/tools/in-sim" "$@"
    ;;

*)
    sed -n '2,12p' "$0"
    exit 1
    ;;
esac
