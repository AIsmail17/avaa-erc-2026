#!/usr/bin/env bash
# Clear everything the simulator leaves behind.
#
#     tools/sweep            kill the lot and say what survived
#
# Every teardown in this project used pkill -f, and pkill -f could not do the job.
# Observed 2026-09-09: five liveviews holding ports 8090-8094, four bridge pairs and four
# grasp nodes burning 70% of a core each, all left over from earlier sessions, with pkill
# reporting success on each of them and every one still running afterwards.
#
# The reason, found later the same day: ros2 run spawns the node with a SLASH.
#
#     wrapper: /opt/ros/humble/bin/ros2 run avaa_solution grasp
#     node   : /opt/erc_ws/install/avaa_solution/lib/avaa_solution/grasp
#
# So "pkill -f 'avaa_solution grasp'" matches the wrapper, kills it, exits 0, and never
# touches the node. The node then keeps running with no parent to stop it -- and a grasp
# node holds the base against its book, so it drives the robot. One was found at 112% of a
# core steering against a drive that was trying to place the robot for a grasp.
#
# This sweep matches on the package name alone, without a following word, so it catches
# both. It also lists the PIDs in one shell and kills them from another, which removes the
# other way pkill goes wrong: its patterns appear in the command line of the shell running
# it, so it can kill itself part way down a list and silently skip the rest. Three rounds,
# because a supervisor can respawn a child once, and the result is checked rather than
# assumed.
#
# Why this matters beyond tidiness: a stale liveview holds its port, so the next one dies
# with "Address already in use" into a log nobody reads while the browser keeps showing a
# picture of a simulation that ended hours ago. That is the frozen view, and it cost the
# better part of two days.
set -u
CONTAINER="${CONTAINER:-erc_sim}"

PAT='gz sim|liveview\.py|parameter_bridge|ros_gz_bridge|avaa_solution|grasp_lab\.launch|simulation\.launch|solution\.launch|moveit\.launch|controller_manager|move_group|robot_state_publisher|ros2 run|ros2 launch|spawner|python3 - '

listing() {
    docker exec "$CONTAINER" ps -eo pid=,args= 2>/dev/null \
        | grep -E "$PAT" | grep -v ' ps -eo'
}

if ! docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true; then
    echo "container $CONTAINER is not running; nothing to sweep"
    exit 0
fi

for round in 1 2 3; do
    pids=$(listing | awk '{print $1}' | tr '\n' ' ')
    [ -z "${pids// /}" ] && break
    echo "round $round: killing $(echo "$pids" | wc -w) processes"
    docker exec "$CONTAINER" kill -9 $pids 2>/dev/null
    sleep 3
done

docker exec "$CONTAINER" rm -f /tmp/pin_base.py /tmp/liveview.py 2>/dev/null

left=$(listing | wc -l)
if [ "$left" -eq 0 ]; then
    echo "container is clear"
else
    echo "$left survived, which should not happen:"
    listing | cut -c1-90 | sed 's/^/    /'
fi

# The container runs on host networking, so a port can be held from outside it too.
for p in 8080 8090 8091 8092 8093 8094 8095 8096 8097 8098 8099; do
    fuser -k "$p"/tcp >/dev/null 2>&1 || true
done
held=$(ss -lntH 2>/dev/null | awk '{print $4}' | grep -cE ':(8080|809[0-9])$' || true)
echo "view ports still held: ${held:-0}"
