#!/bin/bash
# AVAA / ERC 2026 simulation helper.
#
#   sim start     bring the container up (if needed), build (if needed), launch Gazebo
#   sim stop      stop the simulation but leave the container running
#   sim restart   stop then start
#   sim shell     open a shell inside the container, ROS already sourced
#   sim status    what is running right now
#   sim log       follow the simulation log
#   sim gui       attach a viewer to a running (headless) simulation
#   sim build     rebuild the ROS workspace
#   sim rebuild   recreate the container from scratch (destroys install/ and build/)
#
# Safe to run from any directory, in any Ubuntu terminal.

set -u

REPO="$HOME/erc/erc_sim_2026"
CONTAINER="erc_sim"
WS="/opt/erc_ws"
LAUNCH="ros2 launch erc_bringup simulation.launch.py"

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }

# Can we talk to Docker at all?
#
# Every check in this file asks Docker a question and sends the errors to /dev/null, so
# "permission denied on /var/run/docker.sock" comes back looking exactly like "the
# container is not running". On 2026-09-08 that sent `sim restart` down the path of
# creating a container -- destroying the build -- while the real container had been up
# for seventeen hours, and the only thing wrong was the shell.
#
# The usual cause is a session older than the docker group. Adding a user to a group
# changes /etc/group immediately and changes nothing about sessions already logged in,
# so an ssh login made afterwards works while the desktop session started that morning
# does not, on the same machine, as the same user.
docker_reachable() {
    docker version >/dev/null 2>&1
}

require_docker() {
    docker_reachable && return 0
    red "Cannot talk to Docker."
    echo
    if docker version 2>&1 | grep -qi "permission denied"; then
        if id -nG | tr " " "\n" | grep -qx docker; then
            echo "  This shell is in the docker group and still cannot reach the socket."
            echo "  Check the daemon is up:  systemctl status docker"
        else
            echo "  This shell is not in the docker group, though the account may well be:"
            printf "      account is in: %s\n" "$(groups "$USER" 2>/dev/null | cut -d: -f2-)"
            printf "      this shell has: %s\n" "$(id -nG)"
            echo
            echo "  A session started before the group was granted never picks it up."
            echo "  For this terminal only:   newgrp docker"
            echo "  For good:                 log out of the desktop session and back in"
        fi
    else
        echo "  Is the daemon running?  systemctl status docker"
    fi
    return 1
}

container_running() {
    [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = "true" ]
}

sim_running() {
    # Two shapes to match. With the GUI, Gazebo forks a process literally named
    # "gz sim server". Headless, there is no such fork -- it is a single "gz sim -r -s".
    # Matching only the first made a healthy headless simulation look dead.
    docker exec "$CONTAINER" pgrep -f '[g]z sim server' >/dev/null 2>&1 && return 0
    docker exec "$CONTAINER" pgrep -f '[g]z sim -r -s' >/dev/null 2>&1
}

# A launch that has been issued but whose Gazebo has not appeared yet. Checking only for
# 'gz sim server' is not enough: Gazebo takes several seconds to come up, and a second
# 'sim start' in that window would fire a second simulation. That leaves two sets of
# bridge nodes fighting over the same topics, which is confusing and hard to spot.
sim_launching() {
    docker exec "$CONTAINER" pgrep -f '[r]os2 launch erc_bringup' >/dev/null 2>&1
}

workspace_built() {
    docker exec "$CONTAINER" test -f "$WS/install/setup.bash" >/dev/null 2>&1
}

ensure_container() {
    require_docker || return 1
    if container_running; then
        # Also here, not only on the branch that starts one. A container that was
        # already up skipped this entirely, so the tuning only ever happened on the
        # first start after a reboot.
        tune_buffers
        return 0
    fi
    ylw "Container not running - starting it..."
    if docker start "$CONTAINER" >/dev/null 2>&1; then
        sleep 3
    else
        ylw "No existing container. Creating one (this destroys any old build)..."
        (cd "$REPO" && "$(up_script)" >/dev/null 2>&1)
        sleep 4
    fi
    container_running || { red "Could not start the container."; return 1; }
    tune_buffers
    grn "Container up."
}

# Make the kernel allow a receive buffer big enough for one camera frame.
#
# The colour image is 640x360 BGR8, 691 KB, published at 30 simulated Hz. The Linux
# default net.core.rmem_max is 212992 bytes -- less than a third of a single frame -- so
# every frame is fragmented across hundreds of datagrams into a buffer that cannot hold
# one of them, and losing any fragment discards the whole frame. Measured mid-run on
# 2026-09-07: UDP RcvbufErrors at 3,119,527 and climbing by about 200 a second.
#
# What it cost: perception ran for 68 simulated seconds and then reported "no camera
# images arrived at all in the last 10 s" for the rest of the run, while a freshly made
# subscriber on the same topic saw a healthy 30 frames a simulated second. The camera
# was never the problem.
#
# CycloneDDS asks for 32 MB (src/erc_bringup/config/cyclonedds.xml) and the kernel caps
# it here, so both halves are needed. The container is privileged and on the host
# network, so it can set this itself and no password is wanted from anyone.
tune_buffers() {
    local want=33554432 have
    have=$(docker exec "$CONTAINER" sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
    [ "${have:-0}" -ge "$want" ] && return 0
    if docker exec "$CONTAINER" sysctl -q -w net.core.rmem_max=$want \
                                          -w net.core.rmem_default=1048576 >/dev/null 2>&1; then
        ylw "Raised net.core.rmem_max from $have to $want (camera frames are 691 KB)."
    else
        red "Could not raise net.core.rmem_max (it is $have, and one camera frame is"
        red "691 KB). Expect the image stream to stall part-way through a run."
    fi
}

ensure_built() {
    if workspace_built; then
        return 0
    fi
    ylw "Workspace not built (normal after the container is recreated). Building..."
    docker exec "$CONTAINER" /entrypoint.sh bash -c "cd $WS && colcon build --symlink-install" \
        2>&1 | tail -3
    workspace_built || { red "Build failed."; return 1; }
    grn "Build complete."
}

cmd_start() {
    ensure_container || return 1
    ensure_built || return 1
    if sim_running; then
        ylw "Simulation is already running. Use 'sim restart' to relaunch it."
        return 0
    fi
    if sim_launching; then
        ylw "A launch is already in progress. Waiting for it rather than starting a second."
        for _ in $(seq 1 40); do
            sleep 1
            sim_running && break
        done
        if sim_running; then
            grn "Gazebo is running."
            sleep 2
            unminimize_window
            return 0
        fi
        red "That launch did not produce a running Gazebo. Try: sim restart"
        return 1
    fi
    # Anything left over from a previous run competes for the same cores.
    stop_orphans

    local launch_args=""
    local want_window=1
    for arg in "$@"; do
        case "$arg" in
            --fast)
                # depth_to_cloud rebuilds the point cloud from the depth image and costs
                # about a full core. Perception currently uses RGB only, so for
                # development this is pure overhead. Leave it enabled for scored runs if
                # manipulation needs the cloud.
                launch_args="$launch_args depth_cloud:=false"
                ylw "Fast mode: depth point cloud disabled."
                ;;
            --headless)
                # No Gazebo GUI. Worth knowing why this exists: the GUI's Qt/GLX OpenGL
                # context is what dies when WSL drops the virtual GPU
                # ("D3D12: Removing Device" followed by a fallback to swrast and an
                # abort). The server keeps rendering camera images through EGL, so
                # perception still works. It also frees the ~120% CPU the GUI uses.
                # Use the GUI for recording the deliverable video, headless for
                # development.
                launch_args="$launch_args headless:=true"
                want_window=0
                ylw "Headless: no Gazebo window."
                ;;
            *)
                ylw "Ignoring unknown option: $arg"
                ;;
        esac
    done

    ylw "Launching Gazebo..."
    # ERC_GRASP_FIX has to be handed across explicitly: docker exec starts a fresh
    # environment and inherits nothing from the calling shell, so setting it before
    # ./tools/sim looked like it worked and quietly did nothing -- the run came up
    # with zero detachable joints and that read as the flag being off on purpose.
    if [ "${ERC_GRASP_FIX:-}" = "1" ]; then
        ylw "Simulation grasp fix ENABLED (ERC_GRASP_FIX=1)."
    fi
    docker exec -d -e "ERC_GRASP_FIX=${ERC_GRASP_FIX:-0}" "$CONTAINER" /entrypoint.sh bash -c \
        "source $WS/install/setup.bash && exec $LAUNCH $launch_args > /tmp/sim.log 2>&1"
    for _ in $(seq 1 40); do
        sleep 1
        sim_running && break
    done
    if ! sim_running; then
        red "Simulation did not start. Check: sim log"
        return 1
    fi
    grn "Gazebo is running."
    if [ "$want_window" -eq 0 ]; then
        return 0
    fi
    # WSLg maps the window minimized when Gazebo is launched from a detached
    # process, and the taskbar button does not reliably restore it. Un-minimize
    # it from the Windows side.
    sleep 3
    if is_wsl; then
        unminimize_window
        echo
        echo "The title bar reads '[WARN:COPY MODE] Gazebo Sim'. That is a WSLg"
        echo "message about how the window is delivered to Windows. It is not an"
        echo "error and it does not mean software rendering."
    fi
}

# Is this WSL, or a real Linux machine? Two of the messages below only make sense
# under WSL, and printing them on the NUC made a healthy start look broken:
# "powershell.exe not on PATH" is alarming and means nothing there.
# Which bring-up script this host needs.
#
# Both call sites said up-wsl.sh, which demands nvidia-smi and forces Mesa at the d3d12
# Gallium driver. On the NUC -- native Linux, integrated graphics -- that script exits 1
# before creating anything, and `sim start` reports only "Could not start the container"
# with no hint that it tried the wrong one. The container there had been created by hand
# and nobody had needed this path yet.
up_script() {
    if is_wsl; then echo "./docker/up-wsl.sh"; else echo "./docker/up.sh"; fi
}

is_wsl() {
    grep -qi microsoft /proc/version 2>/dev/null
}

unminimize_window() {
    local script="D:\\Projects\\Emirates Robotics Competition\\tools\\restore-gazebo.ps1"
    if ! command -v powershell.exe >/dev/null 2>&1; then
        ylw "powershell.exe not on PATH - if the window stays minimized, restore it manually."
        return 0
    fi
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script" 2>/dev/null \
        | tr -d '\r' | sed 's/^/  /'
}

# Nodes the simulation launch spawns as children. Killing the launch process leaves these
# orphaned and running, and they are not cheap: two stray depth_to_cloud processes burn
# roughly two cores between them, which dragged the real-time factor from ~0.58 down to
# ~0.35 and made the whole simulation look slower than it is.
ORPHAN_PATTERNS=(
    '[d]epth_to_cloud'
    '[p]arameter_bridge'
    '[r]obot_state_publisher'
    '[g]ripper_command_clamp'
    # The simulation grasp fix, for the same reason as everything else here. Five
    # of them were found alive at once on 2026-09-08, ages 639 to 4940 seconds,
    # each polling Gazebo for every book pose every five seconds and each able to
    # weld a book to the gripper on its own initiative.
    '[s]im_grasp_fix'
    '[s]pawner'
    # Our own nodes too. Restarting the simulation leaves them talking to a Gazebo that no
    # longer exists, and the next run then stacks a second copy on top: two approach
    # controllers fighting over /cmd_vel, two robot_state_publishers producing
    # TF_OLD_DATA, and a real-time factor down at 0.08. Every measurement taken in that
    # state is worthless, and it is not obvious from the logs that anything is wrong.
    'avaa_solution/lib'
    # move_group above all. It is not started by the simulation launch, so nothing swept
    # it up, and every 'sim restart' left the previous one running: three were found
    # alive at once, each burning 14 per cent of a core with about 48 minutes of
    # accumulated CPU time. That is not merely waste. They all subscribe to
    # /joint_states, all publish a planning scene, and all answer /check_state_validity
    # and the plan and execute actions, so a request can be served by any of them and
    # each holds its own idea of where the shelf is.
    '[m]ove_group'
    # The live view and its bridge outlive the simulation they were watching.
    '[l]iveview'
)

stop_orphans() {
    for pattern in "${ORPHAN_PATTERNS[@]}"; do
        docker exec "$CONTAINER" pkill -f "$pattern" >/dev/null 2>&1
    done
    sleep 1
    for pattern in "${ORPHAN_PATTERNS[@]}"; do
        docker exec "$CONTAINER" pkill -9 -f "$pattern" >/dev/null 2>&1
    done
}

# Which X display should the viewer draw on?
#
# $DISPLAY when there is one, because then this was run from a terminal inside the
# session that wants the window. Otherwise the newest socket in /tmp/.X11-unix -- on
# the NUC there is no :0 at all: xrdp runs its own Xorg on :10, and the container was
# created over SSH with DISPLAY=:0 baked in, pointing at a display that does not
# exist. The socket directory is mounted either way, so only the number was wrong.
host_display() {
    if [ -n "${DISPLAY:-}" ]; then
        echo "$DISPLAY"
        return
    fi
    local sock
    sock=$(ls -t /tmp/.X11-unix/X* 2>/dev/null | head -1)
    if [ -n "$sock" ]; then echo ":${sock##*/X}"; else echo ":0"; fi
}

cmd_gui() {
    # Attach a viewer to a simulation that is already running headless.
    #
    # Why this exists rather than just launching Gazebo with its GUI: the GUI and the
    # server are one process there, and the GUI is the fragile half. When WSL drops the
    # virtual GPU, Mesa falls back to software rendering, the container's software
    # driver does not work --
    #
    #     libGL error: glx: failed to create drisw screen
    #     libGL error: failed to load driver: swrast
    #     [GUI] [Err] Failed to create OpenGL context
    #
    # -- and Qt aborts. That abort takes the SERVER down with it: the controllers never
    # spawn, every spawner dies with "Could not successfully call service
    # /controller_manager/load_controller", and the whole simulation is gone. A crash in
    # the window should not cost the run.
    #
    # Started separately, the viewer is disposable. If the GPU drops, the window dies and
    # the simulation keeps going at full speed; run 'sim gui' again when it comes back.
    container_running || { red "Container is not running. Run 'sim start' first."; return 1; }
    if ! sim_running; then
        red "Gazebo is not running. Start it headless first:  sim start --fast --headless"
        return 1
    fi
    if docker exec "$CONTAINER" pgrep -f '[g]z sim -g' >/dev/null 2>&1; then
        ylw "A viewer is already running."
        unminimize_window
        return 0
    fi

    # Retry, because the failure is intermittent rather than a misconfiguration.
    #
    # The same command succeeds one minute and aborts the next, and the difference is
    # whether WSL currently has the virtual GPU. When it does, gz sim -g starts clean;
    # when it has dropped, Mesa falls back to a software driver that does not work in
    # this container and Qt aborts. Nothing here fixes that, but it comes back on its
    # own, so trying again turns an intermittent failure into a slow start.
    local attempt=1
    local tries="${GUI_TRIES:-3}"
    while [ "$attempt" -le "$tries" ]; do
    grn "Attaching a viewer (attempt $attempt of $tries)..."
    # The environment is passed with -e rather than exported inside a login shell.
    #
    # 'bash -lc' sources the profile, and that loses LD_LIBRARY_PATH. Without
    # /usr/lib/wsl/lib on it, Mesa cannot find libd3d12.so, silently falls back to the
    # container's software driver -- which does not work -- and Qt aborts:
    #
    #     libGL error: glx: failed to create drisw screen
    #     libGL error: failed to load driver: swrast
    #     [GUI] [Err] Failed to create OpenGL context
    #
    # Passed explicitly, the same command runs clean. This looked exactly like the WSL
    # virtual GPU dropping, which is a real failure that produces the identical message,
    # and that is why it was worth chasing rather than retrying.
    # The Mesa settings here are WSL's and only WSL's: d3d12 talks to the
    # Windows GPU through the virtual adapter, and /usr/lib/wsl/lib is where
    # libd3d12.so lives. On a real Linux box neither exists, and forcing them
    # stops Mesa picking the driver it would have chosen correctly for the
    # Intel graphics through /dev/dri.
    local gui_env=(-e "DISPLAY=$(host_display)"
                   -e QT_X11_NO_MITSHM=1
                   -e XDG_RUNTIME_DIR=/tmp/runtime-root)
    if is_wsl; then
        gui_env+=(-e GALLIUM_DRIVER=d3d12
                  -e MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA
                  -e LD_LIBRARY_PATH=/usr/lib/wsl/lib)
    fi
    grn "Drawing on display $(host_display)."
    docker exec -d "${gui_env[@]}" \
        "$CONTAINER" bash -c \
        'mkdir -p /tmp/runtime-root; exec gz sim -g --gui-config /opt/erc_ws/src/avaa_solution/config/gui.config > /tmp/gui.log 2>&1'

    # Give it time to fail. A GUI that cannot make an OpenGL context dies within a few
    # seconds, and saying so here is worth more than leaving the user watching an empty
    # desktop wondering which of the two things went wrong.
    local waited=0
    while [ "$waited" -lt 25 ]; do
        sleep 1
        waited=$((waited + 1))
        if ! docker exec "$CONTAINER" pgrep -f '[g]z sim -g' >/dev/null 2>&1; then
            if [ "$attempt" -lt "$tries" ]; then
                ylw "The viewer died after ${waited}s; the GPU was probably away. Retrying."
                attempt=$((attempt + 1))
                sleep 5
                continue 2
            fi
            red "The viewer died after ${waited}s on every attempt. The usual cause is"
            red "WSL dropping the virtual GPU; look for 'drisw' in:"
            echo "    docker exec $CONTAINER tail -30 /tmp/gui.log"
            echo
            echo "The simulation itself is unaffected and still running, and"
            echo "tools/in-sim liveview.py serves a view that needs no GPU at all."
            return 1
        fi
        if [ "$waited" -ge 12 ]; then break; fi
    done

    grn "Viewer running (the simulation is untouched if it crashes)."
    unminimize_window
    return 0
    done
    return 1
}

cmd_stop() {
    container_running || { ylw "Container is not running."; return 0; }
    if ! sim_running && ! sim_launching; then
        # Still sweep up strays. A launch whose Gazebo crashed leaves the launch process
        # and its bridge children alive, and the next 'sim start' then refuses to run
        # because it sees a launch already in progress.
        ylw "Simulation was not running (clearing any strays)."
        docker exec "$CONTAINER" pkill -f '[r]os2 launch erc_bringup' >/dev/null 2>&1
        stop_orphans
        return 0
    fi
    # SIGTERM first so Gazebo shuts down cleanly. It can take several seconds,
    # so wait for the process to actually disappear rather than assuming.
    docker exec "$CONTAINER" pkill -f '[r]os2 launch erc_bringup' >/dev/null 2>&1
    docker exec "$CONTAINER" pkill -f '[g]z sim'                  >/dev/null 2>&1
    stop_orphans
    for _ in $(seq 1 20); do
        sim_running || break
        sleep 1
    done
    if sim_running; then
        ylw "Still running after 20s - forcing."
        docker exec "$CONTAINER" pkill -9 -f '[g]z sim'      >/dev/null 2>&1
        docker exec "$CONTAINER" pkill -9 -f '[r]os2 launch' >/dev/null 2>&1
        sleep 2
    fi
    if sim_running; then
        red "Could not stop the simulation."
        return 1
    fi
    grn "Simulation stopped (container left running)."
}

cmd_shell() {
    ensure_container || return 1
    echo "Entering the container. ROS 2 is sourced. Type 'exit' to leave."
    docker exec -it "$CONTAINER" /entrypoint.sh bash -c \
        "[ -f $WS/install/setup.bash ] && source $WS/install/setup.bash; cd $WS; exec bash"
}

cmd_status() {
    require_docker || return 1
    # Which machine is this? The header read "WSL" everywhere, which on the NUC is
    # false and made a native Linux box look like it was running through a
    # compatibility layer.
    if is_wsl; then
        echo "== WSL =="
        echo "  distro : $(uname -r)"
    else
        echo "== Host =="
        echo "  $(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME") — $(uname -r)"
    fi
    echo
    echo "== Docker =="
    if container_running; then
        grn "  container : running"
    else
        red "  container : STOPPED"
    fi
    echo
    echo "== Workspace =="
    if container_running && workspace_built; then
        grn "  build     : present"
    else
        red "  build     : missing (run 'sim build')"
    fi
    echo
    echo "== Simulation =="
    if container_running && sim_running; then
        grn "  gazebo    : running"
        local rtf
        rtf=$(docker exec "$CONTAINER" /entrypoint.sh bash -c \
              "timeout 6 gz topic -t /stats -e -n 1 2>/dev/null | grep real_time_factor" 2>/dev/null)
        [ -n "$rtf" ] && echo "  $rtf"
        echo
        echo "== Sensors =="
        # A simulator that is "running" but blind looks exactly like broken
        # perception, and telling the two apart costs an afternoon.
        #
        # Measured on 2026-09-04: one instance came up with every controller
        # reporting "Configured and activated" in the launch log, gz reporting a
        # healthy 0.34 real-time factor, and the colour camera never publishing a
        # single frame. Perception sat there logging nothing while the base swept a
        # full circle looking for a marker it could not have seen. Nothing in
        # 'sim status' said a word about it, because nothing in 'sim status' looked
        # at a sensor.
        #
        # These are the two that matter: no colour frames means perception is blind,
        # and no joint states means nothing knows where the arm is.
        stream_check "colour camera" \
            /head_front_camera/head_front_camera/color/image_raw
        stream_check "joint states " /joint_states
        udp_drops
    else
        red "  gazebo    : not running (run 'sim start')"
    fi
}

# Are camera frames being lost in the kernel before any node sees them?
#
# A subscription that has stopped receiving looks identical to a camera that has stopped
# publishing, and the difference is here: RcvbufErrors counts datagrams the kernel threw
# away because the socket buffer was full. Any sustained rate means frames are being
# destroyed in transit, and one lost fragment destroys a whole image.
udp_drops() {
    local a b rate limit
    a=$(awk '/^Udp:/{n++; if (n==2) print $6}' /proc/net/snmp)
    sleep 4
    b=$(awk '/^Udp:/{n++; if (n==2) print $6}' /proc/net/snmp)
    rate=$(( (${b:-0} - ${a:-0}) / 4 ))
    limit=$(docker exec "$CONTAINER" sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
    if [ "$rate" -gt 0 ]; then
        red "  udp frames    : LOSING $rate datagrams a second to a full receive buffer"
        red "                  (net.core.rmem_max is $limit; one frame is 691 KB)"
    else
        grn "  udp frames    : none dropped (rmem_max $limit)"
    fi
}

# Is anything actually coming out of this topic? Prints one line either way.
# Is the colour camera actually producing frames? Returns 0 when it is.
#
# The single most expensive failure in this project: Gazebo starts, every controller
# reports "Configured and activated", gz reports a healthy real-time factor, `sim status`
# says running -- and the colour camera never publishes a frame. Perception then sees
# nothing, the approach searches forever, and it looks exactly like a broken robot. It
# cost large parts of three sessions before it was named.
camera_streaming() {
    local n
    n=$(docker exec "$CONTAINER" /entrypoint.sh bash -c         "source /opt/erc_ws/install/setup.bash && timeout 8 ros2 topic hz          /head_front_camera/head_front_camera/color/image_raw 2>&1          | grep -c 'average rate'" 2>/dev/null)
    [ "${n:-0}" -gt 0 ]
}

stream_check() {
    local label="$1" topic="$2" seen
    seen=$(docker exec "$CONTAINER" /entrypoint.sh bash -c \
        "source /opt/erc_ws/install/setup.bash && timeout 6 ros2 topic hz $topic 2>&1 \
         | grep -c 'average rate'" 2>/dev/null)
    if [ "${seen:-0}" -gt 0 ]; then
        grn "  $label : streaming"
    else
        red "  $label : SILENT — the simulation is up but blind. 'sim restart'."
    fi
}

cmd_log() {
    container_running || { red "Container is not running."; return 1; }
    docker exec "$CONTAINER" tail -f /tmp/sim.log
}

cmd_build() {
    ensure_container || return 1
    docker exec "$CONTAINER" /entrypoint.sh bash -c "cd $WS && colcon build --symlink-install" \
        2>&1 | tail -5
}

cmd_rebuild() {
    ylw "Recreating the container. install/ and build/ will be destroyed."
    (cd "$REPO" && "$(up_script)")
    sleep 4
    ensure_built
}

# Start, then check, and if it came up blind restart the CONTAINER and try once more.
#
# Restarting Gazebo alone does not clear it -- measured, three times in a row, each
# leaving the camera silent and the real-time factor at 0.10 to 0.16. Restarting the
# container does, first time, and takes the factor back to 0.43. Whatever accumulates
# lives in the container rather than in the simulator process.
cmd_start_verified() {
    cmd_start "$@"
    sleep 20
    if camera_streaming; then
        return 0
    fi
    ylw "The simulation came up blind -- no colour frames. Restarting the container,"
    ylw "which clears it where restarting Gazebo alone does not."
    docker restart "$CONTAINER" > /dev/null 2>&1
    sleep 12
    cmd_start "$@"
    sleep 20
    if camera_streaming; then
        grn "Recovered: the camera is streaming."
        return 0
    fi
    red "Still blind after a container restart. Something else is wrong -- check"
    red "'sim log' for controller spawners dying on 'after 3 attempts'."
    return 1
}

case "${1:-}" in
    start)   shift; cmd_start_verified "$@" ;;
    stop)    cmd_stop    ;;
    restart) shift; cmd_stop; cmd_start_verified "$@" ;;
    shell)   cmd_shell   ;;
    status)  cmd_status  ;;
    log)     cmd_log     ;;
    gui)     cmd_gui     ;;
    build)   cmd_build   ;;
    rebuild) cmd_rebuild ;;
    *)
        echo "AVAA simulation helper"
        echo
        echo "  sim start     launch Gazebo (starts container + builds if needed)"
        echo "  sim stop      stop Gazebo, keep the container"
        echo "  sim restart   stop then start"
        echo "  sim shell     shell inside the container, ROS 2 sourced"
        echo "  sim status    show what is running"
        echo "  sim log       follow the simulation log"
        echo "  sim gui       attach a viewer window to a running simulation"
        echo "  sim build     rebuild the ROS workspace"
        echo "  sim rebuild   recreate the container from scratch"
        ;;
esac
